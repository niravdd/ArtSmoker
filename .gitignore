.venv/
__pycache__/
*.pyc
.DS_Store
.env
*.egg-info/
.vscode/

# User override files (local config, never committed)
backend/*.user.json

# Claude Code project instructions (local only)
CLAUDE.md

# Claude Code local workspace (skills, settings — never publish to repos)
.claude/

# Internal design docs (merge into SPEC.md after proven)
gpu_optimiser.md

# Generated assets (user data, not tracked)
data/generated/
data/chat/
data/video/

# Cross-process write-lock files (runtime only)
data/.locks/

# Auto-update (zip method) scratch dir + installed-file manifest — runtime only
.update_tmp/
.update_manifest

# Private style profiles (not for public repo)
data/styles/prop-ludo-club/
data/styles/manojs-swordman/
data/styles/deep-water-station/
data/styles/prop-nicholas-lefeuvre/
data/.telemetry/
data/trellis2_full_verify/

# Runtime log files (file logging is on by default; see config.log_to_file)
/logs/

# Server-side managed tools (portable Blender downloaded on-demand for GLB→FBX export)
/tools/

# Local Blender working files (e.g. FBX/USD import test scenes) — never repo content
*.blend
*.blend1
