      "negative_prompt_path": "textToImageParams.negativeText",
      "seed_path": "imageGenerationConfig.seed",
      "dimensions_mode": "pixels",
      "dimensions_paths": {
        "width": "imageGenerationConfig.width",
        "height": "imageGenerationConfig.height"
      },
      "response_image_path": "images[0]",
      "body_template": {
        "taskType": "TEXT_IMAGE",
        "textToImageParams": {},
        "imageGenerationConfig": {
          "numberOfImages": 1
        }
      }
    },
    "stability_text_to_image": {
      "description": "Stability AI text-to-image models (SD 3.5, Ultra, Core). Uses flat prompt field with aspect ratios.",
